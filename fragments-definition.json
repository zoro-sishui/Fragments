{
  "family": "fragments-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::058264245223:role/LabRole",
  "taskRoleArn": "arn:aws:iam::058264245223:role/LabRole",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "fragments-container",
      "image": "058264245223.dkr.ecr.us-east-1.amazonaws.com/fragments:latest",
      "essential": true,
      "cpu": 256,
      "memory": 512,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "AWS_S3_BUCKET_NAME",
          "value": "proka-fragments"
        },
        {
          "name": "AWS_COGNITO_POOL_ID",
          "value": "us-east-1_5H83Huaqe"
        },
        {
          "name": "AWS_COGNITO_CLIENT_ID",
          "value": "4kk051vpb4itnl8k2237i0ogvb"
        },
        {
          "name": "PORT",
          "value": "80"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fragments-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
